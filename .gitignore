```gitignore
# ==============================
# Java / Maven
# ==============================
**/target/

# ==============================
# Node.js / React / Vite
# ==============================
**/node_modules/
**/dist/

# ==============================
# Python
# ==============================
**/.venv/
**/venv/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# ==============================
# Variables de entorno y secretos
# ==============================
.env
.env.*
!.env.example

# ==============================
# IDE / Editores
# ==============================
.vscode/
.idea/
*.code-workspace

# ==============================
# Sistema operativo
# ==============================
Thumbs.db
.DS_Store

# ==============================
# Archivos temporales y logs
# ==============================
*.bak
*.tmp
*.log
*~
errores_extraccion.txt

# ==============================
# Datos generados por el extractor
# ==============================
extractor_pdf_word/actividades.json

# ==============================
# Respaldos locales
# ==============================
scraper_v2/backups/
*_backup*
*_respaldo*
```
